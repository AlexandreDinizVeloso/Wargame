{
  "name": "concordia-wargame",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "npm run typecheck && npm run test:acceptance && vite build",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/smoke-browser.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "server:headless": "tsx server/index.ts --headless",
    "simulate:balance": "tsx scripts/simulate-balance.ts",
    "test:cartographic": "tsx scripts/smoke-cartographic.ts",
    "test:docker": "tsx scripts/smoke-docker.ts",
    "desktop:dev": "npm --prefix desktop start",
    "desktop:package": "npm run build && npm --prefix desktop run package",
    "test:acceptance": "node --import tsx tests/v101-acceptance.test.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.3",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
